# Base de la API existente (sin /api/v1)
API_BASE_URL=https://api.mdmexico.online

# Clave para cifrar la cookie de sesión (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Usar un valor distinto en Production y Preview. Cambiarlo invalida todas las sesiones.
SESSION_SECRET=
