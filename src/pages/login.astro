---
import { readSession, safeNext } from '../lib/auth';

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get('next'), Astro.url.origin);

// Si ya hay sesión, el middleware de la página destino la validará contra la API.
if (await readSession(Astro.cookies)) {
	return Astro.redirect(next, 302);
}

const ERRORS: Record<string, string> = {
	invalid: 'Correo o contraseña incorrectos.',
	inactive: 'Tu cuenta se encuentra inactiva. Contacta al administrador.',
	throttled: 'Demasiados intentos. Espera un minuto e inténtalo de nuevo.',
	unavailable: 'El servicio no está disponible. Inténtalo más tarde.',
	expired: 'Tu sesión expiró. Vuelve a iniciar sesión.',
	password_change: 'Debes cambiar tu contraseña en la plataforma antes de acceder a la documentación.',
};
const error = ERRORS[Astro.url.searchParams.get('error') ?? ''];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>Iniciar sesión · Documentación</title>
	</head>
	<body>
		<main>
			<h1>Documentación</h1>
			<p class="hint">Inicia sesión con tu cuenta de la plataforma.</p>

			{error && <p class="error" role="alert">{error}</p>}

			<form method="post" action="/api/auth/login">
				<input type="hidden" name="next" value={next} />

				<label for="email">Correo</label>
				<input id="email" name="email" type="email" autocomplete="username" required maxlength="255" autofocus />

				<label for="password">Contraseña</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024" />

				<label class="remember">
					<input type="checkbox" name="remember" />
					Recordarme 30 días
				</label>

				<button type="submit">Entrar</button>
			</form>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: #f6f7f9;
		--card: #ffffff;
		--text: #17181c;
		--muted: #5e6371;
		--border: #d6d9e0;
		--accent: #4f46e5;
		--error-bg: #fdecec;
		--error-text: #9b1c1c;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #17181c;
			--card: #22242a;
			--text: #eceef2;
			--muted: #a3a8b5;
			--border: #3a3d46;
			--accent: #8b84ff;
			--error-bg: #3b1d1d;
			--error-text: #f5b4b4;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 16px;
		background: var(--bg);
		color: var(--text);
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
	}
	main {
		width: 100%;
		max-width: 380px;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 32px 28px;
	}
	h1 {
		margin: 0 0 4px;
		font-size: 1.5rem;
	}
	.hint {
		margin: 0 0 24px;
		color: var(--muted);
	}
	form {
		display: grid;
		gap: 8px;
	}
	label {
		font-size: 0.9rem;
		font-weight: 600;
	}
	input[type='email'],
	input[type='password'] {
		width: 100%;
		padding: 10px 12px;
		margin-bottom: 8px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		color: inherit;
		font: inherit;
	}
	.remember {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 400;
		margin: 4px 0 12px;
	}
	button {
		padding: 11px;
		border: 0;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.error {
		margin: 0 0 16px;
		padding: 10px 12px;
		border-radius: 8px;
		background: var(--error-bg);
		color: var(--error-text);
	}
</style>
